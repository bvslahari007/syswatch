[Unit]
Description=SysWatch - System Health & Log Monitoring Service
After=network.target

[Service]
Type=simple
User=lahari
WorkingDirectory=/home/lahari/syswatch/src
ExecStart=/home/lahari/syswatch/venv/bin/python3 -u /home/lahari/syswatch/src/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
